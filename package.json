{
  "name": "openpost",
  "private": true,
  "version": "2.0.0",
  "description": "OpenPost Desktop - offline-first API testing client with embedded backend and local database",
  "author": "hyvercode",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "db:setup": "node scripts/setup-prisma.cjs && npx prisma generate",
    "db:setup:sqlite": "node scripts/setup-prisma.cjs --sqlite && npx prisma generate",
    "predev": "npm run db:setup",
    "dev": "tsx server.ts",
    "dev:monolith": "tsx server.ts",
    "dev:backend": "BACKEND_ONLY=true tsx server.ts",
    "dev:api": "BACKEND_ONLY=true tsx server.ts",
    "dev:frontend": "vite",
    "dev:web": "vite",
    "prebuild": "NODE_ENV=production npm run db:setup",
    "build": "NODE_ENV=production vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:monolith": "NODE_ENV=production vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:backend": "NODE_ENV=production esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:frontend": "NODE_ENV=production vite build",
    "start": "NODE_ENV=production node dist/server.cjs",
    "start:monolith": "NODE_ENV=production node dist/server.cjs",
    "start:backend": "BACKEND_ONLY=true NODE_ENV=production node dist/server.cjs",
    "electron:dev": "npm run db:setup:sqlite && npm run build:frontend && npm run build:backend && electron .",
    "preview": "vite preview",
    "preview:frontend": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "bridge": "node agent/desktop-agent.js",
    "build:agent": "mkdir -p public/downloads && npx pkg agent/desktop-agent.js -t node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path public/downloads",
    "build:electron": "NODE_ENV=production npm run db:setup:sqlite && npm run build:frontend && npm run build:backend && electron-builder build",
    "build:electron:all": "NODE_ENV=production npm run db:setup:sqlite && npm run build:frontend && npm run build:backend && electron-builder build -mwl",
    "build:electron:win": "NODE_ENV=production npm run db:setup:sqlite && npm run build:frontend && npm run build:backend && electron-builder build --win",
    "build:electron:win:nsis": "NODE_ENV=production npm run db:setup:sqlite && npm run build:frontend && npm run build:backend && electron-builder build --win nsis",
    "build:electron:mac": "NODE_ENV=production npm run db:setup:sqlite && npm run build:frontend && npm run build:backend && electron-builder build --mac",
    "build:electron:mac:dmg": "node scripts/build-mac-dmg.cjs",
    "build:electron:linux": "NODE_ENV=production npm run db:setup:sqlite && npm run build:frontend && npm run build:backend && electron-builder build --linux"
  },
  "dependencies": {
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@prisma-next/adapter-mongo": "^0.11.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-mariadb": "^7.9.0",
    "@prisma/adapter-mssql": "^7.9.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.8.0",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "https-proxy-agent": "^9.1.0",
    "idb-keyval": "^6.3.0",
    "ipaddr.js": "^2.5.0",
    "js-yaml": "^5.2.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mariadb": "^3.5.3",
    "mongodb": "^7.5.0",
    "motion": "^12.23.24",
    "mssql": "^12.7.0",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "protobufjs": "^8.7.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "socks-proxy-agent": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/diff": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/ip": "^1.1.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "pkg": "^5.8.1",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.0.0"
  },
  "build": {
    "appId": "com.hyvercode.openpost",
    "productName": "OpenPost",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets/icons"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icons/**/*",
      "package.json",
      "node_modules/**/*",
      "!dist/downloads{,/**/*}",
      "!node_modules/.bin{,/**/*}",
      "!node_modules/@azure{,/**/*}",
      "!node_modules/@firebase{,/**/*}",
      "!node_modules/@fontsource{,/**/*}",
      "!node_modules/@prisma-next{,/**/*}",
      "!node_modules/dompurify{,/**/*}",
      "!node_modules/date-fns{,/**/*}",
      "!node_modules/firebase{,/**/*}",
      "!node_modules/framer-motion{,/**/*}",
      "!node_modules/idb-keyval{,/**/*}",
      "!node_modules/js-yaml{,/**/*}",
      "!node_modules/jspdf{,/**/*}",
      "!node_modules/lucide-react{,/**/*}",
      "!node_modules/motion{,/**/*}",
      "!node_modules/mongodb{,/**/*}",
      "!node_modules/mssql{,/**/*}",
      "!node_modules/papaparse{,/**/*}",
      "!node_modules/protobufjs{,/**/*}",
      "!node_modules/react{,/**/*}",
      "!node_modules/react-dom{,/**/*}",
      "!node_modules/react-markdown{,/**/*}",
      "!node_modules/react-redux{,/**/*}",
      "!node_modules/recharts{,/**/*}",
      "!node_modules/redux{,/**/*}",
      "!node_modules/redux-thunk{,/**/*}",
      "!node_modules/reselect{,/**/*}",
      "!node_modules/tedious{,/**/*}",
      "!node_modules/@tediousjs{,/**/*}",
      "!node_modules/@typespec{,/**/*}",
      "!node_modules/@js-joda{,/**/*}",
      "!node_modules/@mongodb-js{,/**/*}",
      "!node_modules/@azure-rest{,/**/*}",
      "!node_modules/@grpc{,/**/*}",
      "!node_modules/@reduxjs{,/**/*}",
      "!node_modules/@babel/runtime{,/**/*}",
      "!node_modules/@ark{,/**/*}",
      "!node_modules/arkregex{,/**/*}",
      "!node_modules/arktype{,/**/*}",
      "!node_modules/abort-controller{,/**/*}",
      "!node_modules/bson{,/**/*}",
      "!node_modules/canvg{,/**/*}",
      "!node_modules/core-js{,/**/*}",
      "!node_modules/d3-*{,/**/*}",
      "!node_modules/diff{,/**/*}",
      "!node_modules/emoji-regex{,/**/*}",
      "!node_modules/es-toolkit{,/**/*}",
      "!node_modules/eventemitter3{,/**/*}",
      "!node_modules/fast-png{,/**/*}",
      "!node_modules/fflate{,/**/*}",
      "!node_modules/framer-motion{,/**/*}",
      "!node_modules/html2canvas{,/**/*}",
      "!node_modules/js-md4{,/**/*}",
      "!node_modules/mongodb-connection-string-url{,/**/*}",
      "!node_modules/motion-dom{,/**/*}",
      "!node_modules/motion-utils{,/**/*}",
      "!node_modules/pako{,/**/*}",
      "!node_modules/prettier{,/**/*}",
      "!node_modules/re2js{,/**/*}",
      "!node_modules/rgbcolor{,/**/*}",
      "!node_modules/scheduler{,/**/*}",
      "!node_modules/stackblur-canvas{,/**/*}",
      "!node_modules/string-width{,/**/*}",
      "!node_modules/tailwind-merge{,/**/*}",
      "!node_modules/use-sync-external-store{,/**/*}",
      "!node_modules/victory-vendor{,/**/*}",
      "!node_modules/web-vitals{,/**/*}",
      "!node_modules/whatwg-url{,/**/*}",
      "!node_modules/tr46{,/**/*}",
      "!node_modules/webidl-conversions{,/**/*}",
      "!node_modules/yargs{,/**/*}",
      "!node_modules/yargs-parser{,/**/*}",
      "!node_modules/y18n{,/**/*}",
      "!node_modules/wsl-utils{,/**/*}",
      "!node_modules/is-docker{,/**/*}",
      "!node_modules/is-wsl{,/**/*}",
      "!node_modules/zustand{,/**/*}",
      "!node_modules/mdast-*{,/**/*}",
      "!node_modules/micromark{,/**/*}",
      "!node_modules/micromark-*{,/**/*}",
      "!node_modules/unist-*{,/**/*}",
      "!node_modules/unified{,/**/*}",
      "!node_modules/hast-*{,/**/*}",
      "!node_modules/remark-parse{,/**/*}",
      "!node_modules/remark-rehype{,/**/*}",
      "!node_modules/vfile{,/**/*}",
      "!node_modules/vfile-message{,/**/*}",
      "!node_modules/trough{,/**/*}",
      "!node_modules/zwitch{,/**/*}",
      "!node_modules/trim-lines{,/**/*}",
      "!node_modules/longest-streak{,/**/*}",
      "!node_modules/parse-entities{,/**/*}",
      "!node_modules/stringify-entities{,/**/*}",
      "!node_modules/decode-named-character-reference{,/**/*}",
      "!node_modules/devlop{,/**/*}",
      "!node_modules/dequal{,/**/*}",
      "!node_modules/is-plain-obj{,/**/*}",
      "!node_modules/ccount{,/**/*}",
      "!node_modules/comma-separated-tokens{,/**/*}",
      "!node_modules/space-separated-tokens{,/**/*}",
      "!node_modules/character-entities{,/**/*}",
      "!node_modules/character-entities-html4{,/**/*}",
      "!node_modules/character-entities-legacy{,/**/*}",
      "!node_modules/character-reference-invalid{,/**/*}",
      "!node_modules/is-alphabetical{,/**/*}",
      "!node_modules/is-alphanumerical{,/**/*}",
      "!node_modules/is-decimal{,/**/*}",
      "!node_modules/is-hexadecimal{,/**/*}",
      "!node_modules/@prisma/client/runtime/query_compiler*cockroachdb*",
      "!node_modules/@prisma/client/runtime/query_compiler*mysql*",
      "!node_modules/@prisma/client/runtime/query_compiler*postgresql*",
      "!node_modules/@prisma/client/runtime/query_compiler*sqlserver*",
      "!node_modules/@prisma/client/runtime/*.mjs",
      "!node_modules/.prisma/**/wasm-*.mjs",
      "!node_modules/better-sqlite3/deps{,/**/*}",
      "!node_modules/better-sqlite3/src{,/**/*}",
      "!node_modules/better-sqlite3/build/Release/obj{,/**/*}",
      "!node_modules/better-sqlite3/build/Release/test_extension.node",
      "!node_modules/better-sqlite3/build/deps{,/**/*}",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts"
    ],
    "extraResources": [
      {
        "from": "prisma",
        "to": "prisma",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/icon.icns",
      "target": [
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        "portable",
        "zip"
      ],
      "signExecutable": false
    },
    "nsis": {
      "packElevateHelper": false
    },
    "linux": {
      "icon": "assets/icons/icon.png",
      "target": [
        "AppImage",
        "tar.gz"
      ]
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ]
  }
}

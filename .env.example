# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# AI_PROVIDER: gemini | openai (default: gemini)
AI_PROVIDER="gemini" # gemini | openai | ollama | custom
# AI_MODEL: override model (default gemini-1.5-flash / gpt-4o-mini)
AI_MODEL=""
# OPENAI_API_KEY: required when AI_PROVIDER=openai
OPENAI_API_KEY=""
# OLLAMA_BASE_URL: for AI_PROVIDER=ollama (default http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_API_KEY=""
# CUSTOM_AI_BASE_URL / CUSTOM_AI_API_KEY: for AI_PROVIDER=custom (any OpenAI-compatible)
CUSTOM_AI_BASE_URL=""
CUSTOM_AI_API_KEY=""
# AI_BASE_URL: generic override for openai/custom (takes precedence if set)
AI_BASE_URL=""
# AI_MONTHLY_LIMIT: max ai_call per user per bulan (0 = unlimited, default 200)
AI_MONTHLY_LIMIT="200"
# ALLOW_AI_LOCAL: set 1 to allow AI baseUrl to be localhost (ollama/custom local dev)
# ALLOW_AI_LOCAL="0"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CORS_ORIGINS: comma-separated browser origins allowed to call the API.
# Required when the public DNS differs from APP_URL (scheme + host, no trailing slash).
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"

# DATABASE_URL: Database connection string for Prisma
# For local SQLite: file:./dev.db
# For PostgreSQL: postgresql://user:password@localhost:5432/mydb
# For MongoDB: mongodb+srv://user:password@cluster.mongodb.net/mydb
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openpost"

# DB_PROVIDER: The Prisma database provider
# Supported values: sqlite, postgresql, mysql, mongodb, sqlserver, cockroachdb
# Default: sqlite
DB_PROVIDER="postgresql"

# PORT: The port the backend server listens on (default: 3000)
PORT=3000

# Email Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

VITE_API_URL="http://localhost:3000"

# Google Auth OAuth 2.0 Client ID (Optional for Google Identity Services / One Tap)
VITE_GOOGLE_CLIENT_ID=""

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "@@PROVIDER@@"
}

model User {
  uid                @@ID@@
  email              String?           @unique
  password           String?
  displayName        String?
  photoURL           String?
  isEmailVerified    Boolean           @default(false)
  verificationToken  String?           @unique
  resetToken         String?           @unique
  resetTokenExpires  DateTime?
  tokenVersion       Int               @default(0)
  workspaces         WorkspaceMember[]
  comments           Comment[]
}

model Workspace {
  id           @@ID@@
  name         String
  ownerId      String
  deletedAt    DateTime?
  members      WorkspaceMember[]
  collections  Collection[]
  environments Environment[]
  deployments  Deployment[]
  invitations  Invitation[]
  versions     CollectionVersion[]
  monitors     Monitor[]
}

model WorkspaceMember {
  id          @@ID@@
  workspaceId @@FOREIGN_KEY@@
  userId      @@FOREIGN_KEY@@
  role        String    @default("MEMBER")
  status      String    @default("ACTIVE")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Invitation {
  id          @@ID@@
  email       String
  workspaceId @@FOREIGN_KEY@@
  role        String   @default("MEMBER")
  token       String   @unique
  expiresAt   DateTime
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Audit log (PRD #50, #59): who did what, when. No relations on purpose —
// entries must survive deletion of the workspace/user they describe.
model AuditLog {
  id          @@ID@@
  workspaceId String?
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  detail      String?
  createdAt   DateTime  @default(now())
}

// Scheduled monitor (PRD #52): runs a collection on an interval and alerts
// on consecutive failures. intervalMinutes >= 5 to bound server load.
model Monitor {
  id                  @@ID@@
  workspaceId         @@FOREIGN_KEY@@
  collectionId        String
  name                String
  enabled             Boolean  @default(true)
  intervalMinutes     Int      @default(60)
  alertEmail          String?
  slackWebhookUrl     String?
  failThreshold       Int      @default(2)
  lastRunAt           DateTime?
  lastStatus          String?
  consecutiveFailures Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime? @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model MonitorRun {
  id          @@ID@@
  monitorId   String
  status      String
  passed      Int      @default(0)
  failed      Int      @default(0)
  timeMs      Int      @default(0)
  detail      String?
  createdAt   DateTime @default(now())
}

// Usage metering (PRD #58 fase 1 billing): per-user monthly counters for
// billable actions (proxy calls, AI calls). Payment provider later.
model UsageMeter {
  id        @@ID@@
  userId    String
  action    String
  yearMonth String
  count     Int      @default(0)
  updatedAt DateTime? @updatedAt

  @@unique([userId, action, yearMonth])
}

model Collection {
  id          @@ID@@
  workspaceId @@FOREIGN_KEY@@
  name        String
  description String?
  color       String?
  icon        String?
  position    Int      @default(0)
  mockConfig  String?
  folders     String   @default("[]")
  requests    String   @default("[]")
  shareVisibility String @default("private")
  mockVisibility  String @default("private")
  docVisibility   String @default("private")
  deletedAt       DateTime?
  updatedAt       DateTime? @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Environment {
  id          @@ID@@
  workspaceId @@FOREIGN_KEY@@
  name        String
  variables   String    @default("[]")
  position    Int       @default(0)
  deletedAt   DateTime?
  updatedAt   DateTime? @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Deployment {
  id             @@ID@@
  workspaceId    @@FOREIGN_KEY@@
  collectionId   String
  collectionName String
  version        String
  createdAt      DateTime  @default(now())
  requests       String    @default("[]")
  mockConfig     String?
  
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Comment {
  id          @@ID@@
  requestId   String
  userId      @@FOREIGN_KEY@@
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
}

model CollectionVersion {
  id             @@ID@@
  workspaceId    @@FOREIGN_KEY@@
  collectionId   String
  collectionName String
  version        String
  name           String?
  description    String?
  author         String?
  createdAt      DateTime  @default(now())
  folders        String    @default("[]")
  requests       String    @default("[]")
  mockConfig     String?
  tags           String?   @default("[]")
  diffSummary    String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
